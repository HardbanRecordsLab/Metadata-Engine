# =================================================================
# MUSIC METADATA ENGINE - CONSOLIDATED ENVIRONMENT CONFIGURATION
# =================================================================
# Ten plik zawiera WSZYSTKIE zmienne potrzebne do działania aplikacji.
# KOPIUJ te wartości do Secrets na Hugging Face (Backend) oraz Vercel (Frontend).

# -----------------------------------------------------------------
# 🤖 AI SERVICES (Backend / HF Secrets)
# -----------------------------------------------------------------
# Główne modele analizujące muzykę.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
XAI_API_KEY=your_xai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Trzeci głos w konsensusie (tryb "pro") — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Fallback na tanie modele płatne, gdy darmowe OpenRoutera padną (domyślnie off)
OPENROUTER_ALLOW_PAID=false

# -----------------------------------------------------------------
# 💾 DATABASE & AUTHENTICATION (Backend & Frontend)
# -----------------------------------------------------------------
# Ścieżka do lokalnej bazy (Backend):
DATABASE_URL=sqlite:///./music_metadata.db

# -----------------------------------------------------------------
# 🎵 MUSIC APIs (Opcjonalne - Backend / HF Secrets)
# -----------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_id
SPOTIFY_CLIENT_SECRET=your_secret
LASTFM_API_KEY=your_key
AUDD_API_TOKEN=your_token

# -----------------------------------------------------------------
# 🚀 DEPLOYMENT CONFIG (Frontend / Vercel)
# -----------------------------------------------------------------
# Link do Twojego Backend-u na Hugging Face (używany przez proxy)
VITE_API_URL=/api
# Jeśli chcesz bezpośrednio (bez proxy):
# VITE_API_URL=https://twoja-przestrzen.hf.space/api
