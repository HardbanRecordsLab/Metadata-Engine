# =============================================================================
# Metadata Engine — backend .env  (przykład)
#
# PRODUKCJA: tego pliku NIE wypełniasz ręcznie na VPS-ie. Deploy
# (.github/workflows/deploy.yml) zapisuje /srv/hbrl/Metadata-Engine/.env
# z GitHub Secrets. Dodawaj/rotuj klucze w:
#   GitHub → repo → Settings → Secrets and variables → Actions
# LOKALNIE: skopiuj do backend/.env i uzupełnij tym, czego potrzebujesz.
# =============================================================================

# ---- Rdzeń (wymagane) -------------------------------------------------------

# Podpis tokenów JWT. Wygeneruj: openssl rand -hex 32
SECRET_KEY=zmien_mnie_na_dlugi_losowy_ciag

# Baza. PRODUKCJA używa SQLite (vps.docker-compose.yml wymusza
# sqlite:////data/music_metadata.db przez `environment:`, nadpisując tę wartość).
# Lokalnie zostaw SQLite; Postgres tylko jeśli świadomie go stawiasz.
DATABASE_URL=sqlite:///./music_metadata.db

# Lista originów dla CORS (zamiast "*").
CORS_ORIGINS=https://app-metadata.hardbanrecordslab.online

# ---- LLM: aktywny łańcuch konsensusu (wymagane do analizy) -----------------

# GROQ — główny, szybki (Llama). https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# GEMINI — drugi głos. https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# OPENROUTER — trzeci głos (tryb "pro"). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# true = gdy wszystkie darmowe modele OpenRoutera padną, zejdź na tanie płatne
# (gemini-flash-lite / mistral-small, ~$0.0003 / analizę). Domyślnie off.
OPENROUTER_ALLOW_PAID=false

# ---- LLM: obecnie NIEAKTYWNE ----------------------------------------------
# Metody _mistral_classify / _deepseek_classify / _xai_classify istnieją w
# llm_ensemble.py, ale consensus_classification() ich nie wywołuje. Zostaw
# puste, dopóki ktoś świadomie nie przywróci tych providerów.
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ---- IPFS (certyfikaty) — wymagane, jeśli używasz certyfikatów -------------
# https://app.pinata.cloud/developers/keys
PINATA_JWT=eyJhbG...
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---- Stripe (pakiety kredytów) -------------------------------------------
# https://dashboard.stripe.com → Developers → API keys / Webhooks / Products
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PACK_STARTER=price_...
STRIPE_PRICE_PACK_PRODUCER=price_...
STRIPE_PRICE_PACK_LABEL=price_...
STRIPE_PRICE_PACK_STUDIO=price_...
# Opcjonalne:
# STRIPE_SUCCESS_URL=https://app-metadata.hardbanrecordslab.online/?billing=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://app-metadata.hardbanrecordslab.online/?billing=cancelled

# ---- Wzbogacanie metadanych (opcjonalne) ---------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
DISCOGS_API_KEY=
DISCOGS_SECRETS=
ACOUSTID_API=
ACOUSTID_API_TOKEN=

# ACRCloud — rozpoznawanie utworu po próbce audio (serwerowo)
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# ---- E-mail transakcyjny (reset hasła itd.) ----------------------------
# Bez SMTP_HOST maile nie są wysyłane — trafiają do logów (dev/awaria).
APP_BASE_URL=https://app-metadata.hardbanrecordslab.online
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hardbanrecordslab.online
SMTP_STARTTLS=true

# ---- Opcjonalne / awaryjne ----------------------------------------------
# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD — jednorazowe utworzenie
# superusera przy pierwszym starcie, jeśli konto nie istnieje (app/startup.py).
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
